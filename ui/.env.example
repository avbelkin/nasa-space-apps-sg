# Optional locally (Vite proxies /api and /health to http://localhost:5180).
# Set in GitHub Actions repository variables to your Cloud Run HTTPS URL (e.g. https://nasa-space-apps-api-xxxx.asia-southeast1.run.app)
VITE_API_BASE_URL=

# Optional base path override (defaults to / locally and /<repo-name>/ in GitHub Pages workflow)
VITE_BASE_PATH=/
